{
  "project_type": "single",
  "services": {
    "static_generator": {
      "path": ".",
      "tech_stack": ["python3", "pillow"],
      "port": null,
      "dev_command": "python3 scripts/rebuild-index.py",
      "test_command": null,
      "description": "Python script that generates index.html gallery page from image assets"
    },
    "static_site": {
      "path": ".",
      "tech_stack": ["html", "javascript"],
      "port": null,
      "dev_command": "open index.html",
      "test_command": null,
      "description": "GitHub Pages static site serving the generated gallery"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": null,
    "hosting": "github_pages"
  },
  "conventions": {
    "linter": null,
    "formatter": null,
    "testing": null,
    "security": "Content-Security-Policy via meta tags (no server headers on GitHub Pages)"
  },
  "entry_points": {
    "generator": "scripts/rebuild-index.py",
    "output": "index.html"
  }
}
